{
  "packer": {
    "required_plugins": {
      "googlecompute": {
        "source": "github.com/hashicorp/googlecompute",
        "version": "~> 1"
      }
    }
  },
  "builders": [
    {
      "type": "googlecompute",
      "project_id": "apt-index-474313-e9",
      "region": "us-central1",
      "zone": "us-central1-a",
      "omit_external_ip": false,
      "use_internal_ip": false,
      "tags": ["yba-gcp-image-2"],
      "ssh_username": "yugabyte",
      "machine_type": "e2-standard-4",
      "source_image_family": "rhel-9",
      "source_image_project_id": "rhel-cloud",
      "image_name": "yba-gcp-{{timestamp}}",
      "image_family": "yba-gcp-image",
      "disk_size": 20,
      "disk_type": "pd-ssd"
    }
  ],
  "provisioners": [
    {
      "type": "shell",
      "inline": [
        "sudo yum install -y wget curl tar"
      ]
    },
    {
      "type": "ansible",
      "playbook_file": "./yba_2024_db_node.yaml ",
      "extra_arguments": [
        "--vault-password-file=./pass.txt"
      ],
      "use_proxy": false
    }
  ]
}
